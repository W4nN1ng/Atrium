{
  "name": "a-asset-manager",
  "productName": "Atrium",
  "version": "0.9.2",
  "description": "Atrium（代号 A）—— VRChat 素材管家：拖入自动解压、读懂内容、自动分类归档、Unity 一键批量导入",
  "main": "./out/main/index.js",
  "author": "A",
  "license": "MIT",
  "private": true,
  "scripts": {
    "setup": "node tools/setup-native.cjs all",
    "native:electron": "node tools/setup-native.cjs electron",
    "native:node": "node tools/setup-native.cjs node",
    "dev": "npm run native:electron && node tools/dev.cjs",
    "dev:debug": "npm run native:electron && node tools/dev.cjs --remote-debugging-port=9222",
    "start": "electron-vite preview",
    "build": "npm run test && npm run native:electron && electron-vite build && node tools/check-worker-deps.cjs && electron-builder --win",
    "build:dir": "npm run native:electron && electron-vite build && node tools/check-worker-deps.cjs && electron-builder --win --dir",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "npm run native:node && vitest run",
    "test:watch": "node tools/setup-native.cjs node && vitest",
    "icon": "python tools/make_icon.py",
    "lexicon": "node tools/build-lexicon.cjs"
  },
  "dependencies": {
    "better-sqlite3": "12.4.1",
    "chokidar": "^3.6.0",
    "electron-log": "^5.2.4",
    "electron-store": "^8.2.0",
    "hash-wasm": "^4.11.0",
    "iconv-lite": "^0.6.3",
    "minisearch": "^7.1.0",
    "pinyin-pro": "^3.24.0",
    "tar": "^6.2.1",
    "wanakana": "^5.3.1",
    "yauzl": "^3.1.2",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/tar": "^6.1.13",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "33.4.11",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "i18next": "^23.15.1",
    "node-abi": "^3.71.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.2",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "vitest": "^2.1.1",
    "zustand": "^4.5.5"
  }
}
