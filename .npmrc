# 这台机器上 registry.npmjs.org 取整份 packument 会超时（实测 136 秒 / ETIMEDOUT / ECONNRESET），
# 所以项目内固定走 npmmirror。全局配置没动，删掉本文件即可回到官方源。
registry=https://registry.npmmirror.com
fetch-retries=3
fetch-retry-mintimeout=8000
fetch-timeout=180000
# 原生模块的 install 脚本一律跳过：better-sqlite3 由 tools/setup-native.cjs 摆放预编译 .node，
# Electron 本体由同一个脚本从 npmmirror 下载。
ignore-scripts=true
